# FinShield Environment Configuration
# Copy to .env and fill in values — never commit .env

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finshield
DB_USER=finshield_user
DB_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://finshield_user:change_me_strong_password@localhost:5432/finshield

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=finshield_fraud_detection

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_to_random_64_char_string
API_WORKERS=4

# Dashboard
STREAMLIT_PORT=8501

# Azure (for cloud deployment)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=finshield-rg
AZURE_REGISTRY=finshieldacr
AZURE_SQL_CONNECTION_STRING=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
